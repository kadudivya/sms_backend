# Copy to .env and fill in. Every setting lives in config.py; this file only holds secrets and per-machine values.
APP_ENV=development
SECRET_KEY=replace-with-64-random-characters
JWT_SECRET_KEY=replace-with-64-random-characters

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sms_dev
TEST_DB_NAME=sms_test
# or a full URL: DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/sms

NOTIFICATIONS_SEND_ASYNC=true

FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# Providers (console = log only, for development)
EMAIL_BACKEND=console
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@your-domain.in
SMS_BACKEND=console
MSG91_AUTH_KEY=
WHATSAPP_BACKEND=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

STORAGE_BACKEND=local
S3_BUCKET=
